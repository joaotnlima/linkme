# ---- Local mode (default) ----------------------------------------------
# Leave DATABASE_URL and the Supabase vars empty and `npm run dev` runs on an
# embedded Postgres (PGlite, stored in .data/) with /admin open (no login).

# ---- Supabase mode -------------------------------------------------------
# Project settings → Database → Connection string → "Transaction" pooler (port 6543)
DATABASE_URL=
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Your GitHub numeric user id (https://api.github.com/users/<login> → "id")
OWNER_GITHUB_ID=
# Public origin, used for OAuth redirects and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Instagram Graph API long-lived token (Creator/Business account) for feed sync
INSTAGRAM_ACCESS_TOKEN=

# Secret for POST /api/ingest (share sheet / bookmarklet). Generate: openssl rand -hex 24
INGEST_TOKEN=

# Force /admin open without login (never in production)
ADMIN_DEV_BYPASS=
