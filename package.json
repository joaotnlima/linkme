{
  "name": "linkme",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @linkme/web",
    "build": "npm run build -w @linkme/web",
    "start": "npm run start -w @linkme/web",
    "lint": "npm run lint -w @linkme/web",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p packages/core",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/core/lib/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "Self-hosted link-in-bio page with a phone-first backoffice. Next.js + Supabase (or embedded Postgres locally).",
  "license": "SEE LICENSE IN LICENSE"
}
